function(xstd_check_compiler compiler version)
    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        set(compiler "GCC" PARENT_SCOPE)
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
        set(compiler "MSVC" PARENT_SCOPE)
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        set(compiler "clang" PARENT_SCOPE)
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
        set(compiler "apple-clang" PARENT_SCOPE)
    else()
        message(STATUS "${CMAKE_CXX_COMPILER_ID} compiler is not supported")
    endif()
    set(version "${CMAKE_CXX_COMPILER_VERSION}" PARENT_SCOPE)
endfunction()